# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must always use LF line endings (for Linux/macOS/containers)
*.sh text eol=lf

# Environment files must use LF (sourced by shell scripts in containers)
.env text eol=lf
.env.* text eol=lf
*.env text eol=lf

# Batch files must always use CRLF line endings (for Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell can use either, but LF is safer for cross-platform
*.ps1 text eol=lf

# Docker files should use LF
Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Git config files
.gitattributes text eol=lf
.gitignore text eol=lf

# EditorConfig
.editorconfig text eol=lf

# Makefiles must use LF
Makefile text eol=lf

# Keep binary files as-is
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.war binary
*.ear binary
*.zip binary
*.tar.gz binary
*.tgz binary
