<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle Configuration for Wordle Kata Backend
    Based on Google Java Style with practical modifications.

    Run with: mvn checkstyle:check
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Exclude generated files -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value=".*[\\/]target[\\/].*"/>
    </module>

    <!-- File length: max 500 lines (warn at 300, error at 500) -->
    <module name="FileLength">
        <property name="max" value="500"/>
        <property name="severity" value="error"/>
    </module>

    <!-- No tabs, use spaces -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Trailing whitespace -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Line has trailing whitespace."/>
    </module>

    <!-- Newline at end of file -->
    <module name="NewlineAtEndOfFile"/>

    <module name="TreeWalker">
        <!-- ==================== NAMING CONVENTIONS ==================== -->

        <!-- Package names: lowercase only -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- Type names: PascalCase -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Method names: camelCase -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Constants: UPPER_SNAKE_CASE -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <!-- Local variables: camelCase -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Parameters: camelCase -->
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Member variables: camelCase (no prefix) -->
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- ==================== IMPORTS ==================== -->

        <!-- No star imports -->
        <module name="AvoidStarImport"/>

        <!-- No redundant imports -->
        <module name="RedundantImport"/>

        <!-- No unused imports -->
        <module name="UnusedImports"/>

        <!-- ==================== CODE STRUCTURE ==================== -->

        <!-- Method length: max 50 lines -->
        <module name="MethodLength">
            <property name="max" value="50"/>
        </module>

        <!-- Parameter number: max 5 parameters -->
        <module name="ParameterNumber">
            <property name="max" value="5"/>
            <property name="ignoreOverriddenMethods" value="true"/>
        </module>

        <!-- Cyclomatic complexity: max 10 -->
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
        </module>

        <!-- ==================== WHITESPACE ==================== -->

        <!-- Whitespace after comma, semicolon, typecast -->
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA, SEMI, TYPECAST"/>
        </module>

        <!-- Whitespace around operators -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
        </module>

        <!-- No whitespace after certain tokens -->
        <module name="NoWhitespaceAfter">
            <property name="tokens" value="AT, INC, DEC, UNARY_MINUS, UNARY_PLUS, BNOT, LNOT, DOT, ARRAY_DECLARATOR, INDEX_OP"/>
        </module>

        <!-- No whitespace before certain tokens -->
        <module name="NoWhitespaceBefore">
            <property name="tokens" value="COMMA, SEMI, POST_INC, POST_DEC, ELLIPSIS"/>
        </module>

        <!-- Generic whitespace -->
        <module name="GenericWhitespace"/>

        <!-- ==================== BLOCKS ==================== -->

        <!-- Left curly brace at end of line -->
        <module name="LeftCurly"/>

        <!-- Right curly brace on same line as next statement -->
        <module name="RightCurly"/>

        <!-- Need braces for all blocks -->
        <module name="NeedBraces"/>

        <!-- Avoid nested blocks -->
        <module name="AvoidNestedBlocks"/>

        <!-- Empty blocks should have comment -->
        <module name="EmptyBlock">
            <property name="option" value="TEXT"/>
        </module>

        <!-- ==================== CODING ==================== -->

        <!-- Avoid inline conditionals (ternary abuse) - disabled, ternary is fine -->
        <!-- <module name="AvoidInlineConditionals"/> -->

        <!-- Empty statement (lone semicolon) -->
        <module name="EmptyStatement"/>

        <!-- Equals and hashCode must be overridden together -->
        <module name="EqualsHashCode"/>

        <!-- No assignment in subexpressions -->
        <module name="InnerAssignment"/>

        <!-- Use Java style array declaration: String[] args not String args[] -->
        <module name="ArrayTypeStyle"/>

        <!-- Default comes last in switch -->
        <module name="DefaultComesLast"/>

        <!-- Fall through in switch requires comment -->
        <module name="FallThrough"/>

        <!-- One statement per line -->
        <module name="OneStatementPerLine"/>

        <!-- String literal equality: use .equals() not == -->
        <module name="StringLiteralEquality"/>

        <!-- Simplify boolean expressions -->
        <module name="SimplifyBooleanExpression"/>

        <!-- Simplify boolean return -->
        <module name="SimplifyBooleanReturn"/>

        <!-- ==================== MODIFIERS ==================== -->

        <!-- Modifier order -->
        <module name="ModifierOrder"/>

        <!-- Redundant modifiers (e.g., public in interface) -->
        <module name="RedundantModifier"/>

        <!-- ==================== ANNOTATIONS ==================== -->

        <!-- Annotation location -->
        <module name="AnnotationLocation">
            <property name="allowSamelineMultipleAnnotations" value="false"/>
            <property name="allowSamelineSingleParameterlessAnnotation" value="true"/>
            <property name="allowSamelineParameterizedAnnotation" value="false"/>
        </module>

        <!-- ==================== JAVADOC (relaxed) ==================== -->

        <!-- Javadoc on public API types is recommended but not required -->
        <!-- This is a kata project, so we keep this as a warning -->
        <module name="MissingJavadocType">
            <property name="severity" value="warning"/>
            <property name="scope" value="public"/>
            <property name="excludeScope" value="nothing"/>
            <property name="skipAnnotations" value="Generated,SpringBootApplication,RestController,Service,Repository,Component,Configuration,Data,Value,Builder,Getter,Setter,AllArgsConstructor,NoArgsConstructor,RequiredArgsConstructor"/>
        </module>

        <!-- ==================== MISCELLANEOUS ==================== -->

        <!-- Indentation: 4 spaces -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="4"/>
            <property name="lineWrappingIndentation" value="4"/>
            <property name="arrayInitIndent" value="4"/>
        </module>

        <!-- Upper case L for long literals -->
        <module name="UpperEll"/>

        <!-- Outer type filename -->
        <module name="OuterTypeFilename"/>
    </module>
</module>
