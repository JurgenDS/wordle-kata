<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude Spring Boot main application class -->
    <Match>
        <Class name="com.example.hello.HelloWorldApplication"/>
    </Match>

    <!-- Exclude MapStruct generated code -->
    <Match>
        <Class name="~.*MapperImpl"/>
    </Match>

    <!-- Exclude Lombok generated code (equals, hashCode, toString) -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Or>
            <Method name="getters"/>
        </Or>
    </Match>

    <!-- Exclude test classes -->
    <Match>
        <Source name="~.*Test\.java"/>
    </Match>
    <Match>
        <Source name="~.*Tests\.java"/>
    </Match>

    <!-- Common false positives with Spring Framework -->
    <!-- Spring handles null checking via annotations -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Class name="~.*Controller"/>
    </Match>

    <!-- Exclude configuration classes that expose internal state by design -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="~.*Config"/>
    </Match>

    <!-- Exclude Spring WebConfig from FindSecBugs CORS detector -->
    <!-- This is a known issue with FindSecBugs CorsRegistryCORSDetector -->
    <!-- See: https://github.com/find-sec-bugs/find-sec-bugs/issues -->
    <Match>
        <Class name="com.example.hello.config.WebConfig"/>
        <Bug pattern="PERMISSIVE_CORS"/>
    </Match>
</FindBugsFilter>
