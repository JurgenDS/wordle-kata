<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Suppress ArchUnit ClassFileProcessor warnings during tests -->
    <logger name="com.tngtech.archunit.core.importer.ClassFileProcessor" level="ERROR"/>
    
    <!-- Standard console appender for test output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

