{
  "name": "Wordle Kata Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",

  // All tools (zsh, git, gh) are pre-installed in the Docker image
  // No features needed - this ensures the pre-built image is used directly

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.organizeImports": "explicit"
        },
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.server.launchMode": "Standard",
        "java.compile.nullAnalysis.mode": "automatic",
        "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
        "typescript.preferences.importModuleSpecifier": "relative",
        "typescript.updateImportsOnFileMove.enabled": "always",
        "[java]": {
          "editor.defaultFormatter": "redhat.java"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[html]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[scss]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "files.exclude": {
          "**/node_modules": true,
          "**/target": true,
          "**/.angular": true
        },
        "search.exclude": {
          "**/node_modules": true,
          "**/target": true,
          "**/.angular": true,
          "**/dist": true,
          "**/coverage": true
        }
      },
      "extensions": [
        "redhat.java",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-test",
        "vscjava.vscode-maven",
        "vscjava.vscode-spring-boot-dashboard",
        "vmware.vscode-spring-boot",
        "Pivotal.vscode-boot-dev-pack",
        "angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "orta.vscode-jest",
        "ryanluker.vscode-coverage-gutters",
        "eamodio.gitlens",
        "usernamehw.errorlens",
        "sonarsource.sonarlint-vscode",
        "streetsidesoftware.code-spell-checker",
        "EditorConfig.EditorConfig",
        "ms-azuretools.vscode-docker",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  },

  "forwardPorts": [4200, 8080, 9323],
  "portsAttributes": {
    "4200": {
      "label": "Angular Frontend",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Spring Boot Backend",
      "onAutoForward": "notify"
    },
    "9323": {
      "label": "Playwright Report",
      "onAutoForward": "silent"
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "remoteUser": "vscode",

  "containerEnv": {
    "TZ": "UTC",
    "JAVA_HOME": "/usr/lib/jvm/temurin-21-jdk",
    "MAVEN_OPTS": "-Xmx1024m"
  },

  // Note: node_modules are NOT mounted as volumes - they're created fresh each time
  // The pnpm store (cached in docker-compose.yml) ensures fast installs
  "mounts": [
    "source=${localWorkspaceFolderBasename}-maven-cache,target=/home/vscode/.m2,type=volume",
    "source=${localWorkspaceFolderBasename}-pnpm-cache,target=/home/vscode/.local/share/pnpm,type=volume"
  ],

  "hostRequirements": {
    "cpus": 4,
    "memory": "6gb",
    "storage": "32gb"
  }
}
