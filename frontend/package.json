{
  "name": "hello-world-frontend",
  "version": "1.0.0",
  "description": "Hello World Angular Frontend",
  "scripts": {
    "start": "nx serve hello-world-frontend",
    "build": "nx build hello-world-frontend",
    "test": "cypress run --component",
    "test:open": "cypress open --component",
    "test:coverage": "cypress run --component && nyc report --reporter=text-summary",
    "lint": "nx lint hello-world-frontend",
    "format": "prettier --write \"**/*.{ts,html,scss,css,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,html,scss,css,json}\" --ignore-path .gitignore"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@standard-schema/spec": "^1.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular-devkit/core": "^21.0.0",
    "@angular-devkit/schematics": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@cypress/code-coverage": "^3.14.7",
    "@cypress/schematic": "^4.1.4",
    "@cypress/webpack-preprocessor": "^7.0.2",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@nx/angular": "^22.1.1",
    "@nx/jest": "22.1.1",
    "@nx/js": "22.1.1",
    "@schematics/angular": "^21.0.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.3",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^30.0.0",
    "@types/node": "24.10.1",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "21.0.1",
    "cypress": "^15.7.0",
    "eslint": "^9.39.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-preset-angular": "~15.0.3",
    "jest-util": "^30.2.0",
    "nx": "^22.1.1",
    "nyc": "^17.1.0",
    "prettier": "^3.6.2",
    "source-map": "^0.7.6",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.47.0"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": ">=4.1.1",
      "vite": "5.4.21"
    }
  }
}
