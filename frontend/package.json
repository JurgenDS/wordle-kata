{
  "name": "hello-world-frontend",
  "version": "1.0.0",
  "description": "Hello World Angular Frontend",
  "scripts": {
    "start": "nx serve hello-world-frontend",
    "build": "nx build hello-world-frontend",
    "test": "cypress run --component",
    "test:open": "cypress open --component",
    "test:coverage": "cypress run --component && nyc report --reporter=text-summary",
    "lint": "nx lint hello-world-frontend",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@standard-schema/spec": "^1.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@cypress/code-coverage": "^3.14.7",
    "@cypress/schematic": "^4.1.4",
    "@cypress/webpack-preprocessor": "^7.0.2",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@nx/angular": "^22.1.1",
    "angular-eslint": "20.6.0",
    "cypress": "^15.7.0",
    "eslint": "^9.39.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "nx": "^22.1.1",
    "nyc": "^17.1.0",
    "prettier": "^3.6.2",
    "source-map": "^0.7.6",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.46.3"
  }
}
