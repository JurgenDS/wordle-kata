{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "hello-world-frontend": {
      "projectType": "application",
      "root": "apps/hello-world-frontend",
      "sourceRoot": "apps/hello-world-frontend/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/hello-world-frontend",
            "index": "apps/hello-world-frontend/src/index.html",
            "browser": "apps/hello-world-frontend/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.json",
            "assets": [],
            "styles": ["apps/hello-world-frontend/src/styles.scss"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "fileReplacements": [
                {
                  "replace": "apps/hello-world-frontend/src/environments/environment.ts",
                  "with": "apps/hello-world-frontend/src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "hello-world-frontend:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "apps/hello-world-frontend/src/**/*.ts",
              "apps/hello-world-frontend/src/**/*.html",
              "libs/**/*.ts",
              "libs/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  }
}
