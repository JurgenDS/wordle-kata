{
  "report-dir": "coverage",
  "reporter": ["html", "json", "text", "lcov"],
  "extension": [".ts"],
  "exclude": [
    "**/*.cy.ts",
    "**/*.spec.ts",
    "**/cypress/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/main.ts",
    "**/app.component.ts",
    "**/index.ts",
    "**/environments/**",
    "**/*.config.ts"
  ],
  "all": true,
  "check-coverage": true,
  "lines": 80,
  "statements": 80,
  "functions": 80,
  "branches": 70
}
